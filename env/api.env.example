# Names only. Fill real values in env/api.env (git-ignored).
NODE_ENV=
# Blank or 5000: the image HEALTHCHECK probes :5000.
PORT=
LOG_LEVEL=
# Behind Caddy set TRUST_PROXY=1, otherwise every client shares Caddy's IP in the rate limiters.
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=
CLIENT_ORIGINS=
CLIENT_APP_URL=
GOOGLE_CLIENT_APP_URL=
PUBLIC_API_URL=
MONGO_URI=
REDIS_URL=
JWT_SECRET=
BCRYPT_ROUNDS=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
MAIL_SAFETY_POLL_MINUTES=
MAIL_ANALYSIS_MESSAGE_LIMIT=
GMAIL_SYNC_MESSAGE_LIMIT=
MICROSOFT_SYNC_MESSAGE_LIMIT=
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=
# Mail analysis (Top K) and TRACE need these; TRACE_PROVIDER must match rag.env.
INCEPTION_API_KEY=
INCEPTION_MODEL=
INCEPTION_DECISION_MODEL=
TRACE_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Chat is forwarded to the rag service (URL host must be owntrace-trace).
TRACE_EXECUTION_MODE=
TRACE_SERVICE_URL=
TRACE_SERVICE_TOKEN=
