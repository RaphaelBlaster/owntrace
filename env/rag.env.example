# Names only. Fill real values in env/rag.env (git-ignored).
# No Google/Microsoft credentials and no TOKEN_ENCRYPTION_KEY here by design.
NODE_ENV=
LOG_LEVEL=
MONGO_URI=
# JWT_SECRET is required: the TRACE service verifies the session cookie the api
# forwards (trace-server.js calls getJwtSecret(); requireAuth verifies the JWT).
JWT_SECRET=
# Set TRACE_SERVICE_HOST=0.0.0.0 in the container.
TRACE_SERVICE_HOST=
TRACE_SERVICE_PORT=
TRACE_SERVICE_TOKEN=
TRACE_MAX_CONCURRENT=
TRACE_PROVIDER=
INCEPTION_API_KEY=
INCEPTION_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
TRACE_GUARD=
TRACE_GUARD_MODEL=
TRACE_PARALLEL_TOOL_CALLS=
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=
MAIL_ANALYSIS_MESSAGE_LIMIT=
