# Names only. Fill real values in env/mail-worker.env (git-ignored).
NODE_ENV=
# Blank or 5000: the image HEALTHCHECK probes :5000.
PORT=
LOG_LEVEL=
SHUTDOWN_TIMEOUT_MS=
# Required with NODE_ENV=production (HTTPS origins), same values as api.env.
CLIENT_ORIGINS=
CLIENT_APP_URL=
GOOGLE_CLIENT_APP_URL=
PUBLIC_API_URL=
MONGO_URI=
REDIS_URL=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=
# Gmail watch renewal runs in this role.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
MAIL_SAFETY_POLL_MINUTES=
MAIL_ANALYSIS_MESSAGE_LIMIT=
GMAIL_SYNC_MESSAGE_LIMIT=
MICROSOFT_SYNC_MESSAGE_LIMIT=
ORDER_WORKER_ENABLED=
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=
# Top K mail analysis runs here and needs these.
INCEPTION_API_KEY=
INCEPTION_MODEL=
INCEPTION_DECISION_MODEL=
