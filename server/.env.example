NODE_ENV=development
PORT=5000
LOG_LEVEL=info
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
CLIENT_ORIGINS=http://localhost:5173
MONGO_URI=
JWT_SECRET=
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/microsoft/oauth/callback
MICROSOFT_TENANT=common
CLIENT_APP_URL=http://localhost:5173
# Optional Google return origin when migrating a provider to a new hostname.
GOOGLE_CLIENT_APP_URL=
# Public server origin for Microsoft Graph change notifications. Set this to
# the deployed HTTPS origin (for example, https://api.example.com).
PUBLIC_API_URL=
# Gmail push requires a Pub/Sub topic plus an authenticated push subscription.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_MESSAGE_LIMIT=2000
MICROSOFT_SYNC_MESSAGE_LIMIT=2000
# TRACE defaults to Inception. Switch to azure when that deployment is ready.
TRACE_PROVIDER=inception
INCEPTION_API_KEY=
# Mercury 2 selected temporarily after live 2.5 generation returned server errors.
# Set mercury-2.5 explicitly when its deployment is functioning.
INCEPTION_MODEL=mercury-2
# Semantic OwnTrace scope/risk gate; cannot authorize writes.
INCEPTION_DECISION_MODEL=mercury-decide
# Azure OpenAI Chat Completions with structured function calling.
# Supply these server-side only. Deployment must support function calling.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Leave empty for /openai/v1. For legacy mode supply a supported api-version
# and use the resource root as AZURE_OPENAI_ENDPOINT.
AZURE_OPENAI_API_VERSION=
# Jev filters Top K email metadata; TRACE uses its conversation provider for retrieval planning.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Explicit execution mode; remote failure never falls back to web-process execution.
TRACE_EXECUTION_MODE=local
TRACE_MAX_CONCURRENT=4
# Remote mode requires an internal origin and a shared random token (32+ characters).
TRACE_SERVICE_URL=http://127.0.0.1:5001
TRACE_SERVICE_TOKEN=
TRACE_SERVICE_PORT=5001
# Bind 0.0.0.0 only on a private container network; never publish the service port.
TRACE_SERVICE_HOST=127.0.0.1
# Web process only. The independent TRACE entrypoint never starts order scanning.
ORDER_WORKER_ENABLED=true
# Optional same-host Redis used as an append-only write buffer for sanitized
# order metadata: OrderEvent, OrderReceipt, Gmail/Outlook signal matches.
# Use localhost or the owntrace-redis service name; managed endpoints are
# rejected. Leave empty to write straight to Mongo.
ORDER_REDIS_URL=
# Envelopes drained per batch; one Mongo bulkWrite per model, events first.
ORDER_WRITE_BUFFER_BATCH_SIZE=200
# Stream read, stalled-consumer claim and retry pacing.
ORDER_WRITE_BUFFER_BLOCK_MS=2000
ORDER_WRITE_BUFFER_CLAIM_IDLE_MS=60000
ORDER_WRITE_BUFFER_RETRY_DELAY_MS=1000
# Consecutive batch failures before a batch stays pending and is stepped over.
ORDER_WRITE_BUFFER_MAX_BATCH_FAILURES=3
